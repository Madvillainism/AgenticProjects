---
import products from "../data/products.json";
import ProductCard from "./ProductCard.astro";
---
<section id="products" class="products-section">
  <h2 class="section-title">Fresh <span>Drops</span></h2>
  <p class="section-subtitle">Limited heat. Secure yours before they're gone.</p>
  <div class="drip-divider" style="display:flex;justify-content:center;margin:-1rem 0 2rem"><svg viewBox="0 0 120 12" fill="none" width="80"><path d="M0 6 Q10 0 20 6 Q30 12 40 6 Q50 0 60 6" stroke="#ffe600" stroke-width="1" opacity="0.4"/><circle cx="30" cy="6" r="2" fill="#00f0ff" opacity="0.6"/><circle cx="60" cy="6" r="2" fill="#ff00aa" opacity="0.5"/></svg></div>
  <div class="product-grid">
    {products.map((product) => (
      <ProductCard
        id={product.id}
        name={product.name}
        category={product.category}
        price={product.price}
        currency={product.currency}
        image={product.image}
        description={product.description}
        badges={product.badges}
      />
    ))}
  </div>
</section>

<style>
  .products-section { padding: 3rem 0; background: var(--charcoal); }
</style>