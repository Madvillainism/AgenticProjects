---
import EmptyState from "./EmptyState.astro";
import LoadingSpinner from "./LoadingSpinner.astro";
---

<section class="journal-section">
  <h2 class="section-title">Cierre del Mes</h2>

  <div id="journal-empty" class="empty-container">
    <EmptyState>
      Completa un <a href="/plan">plan mensual</a> y registra <a href="/gastos">gastos</a> antes de cerrar el mes.
    </EmptyState>
  </div>

  <div id="journal-loader" class="journal-loader">
    <LoadingSpinner label="Cargando resumen..." />
  </div>

  <div id="journal-content" class="journal-content">
    <div class="close-summary">
      <div class="cs-card cs-income">
        <span class="cs-label">Ingreso</span>
        <span class="cs-value" id="cs-ingreso">$0.00</span>
      </div>
      <div class="cs-card cs-expense">
        <span class="cs-label">Gastos</span>
        <span class="cs-value" id="cs-gastos">$0.00</span>
      </div>
      <div class="cs-card cs-balance">
        <span class="cs-label">Balance</span>
        <span class="cs-value" id="cs-balance">$0.00</span>
      </div>
    </div>

    <label class="field">
      <span class="label">¿Qué aprendiste este mes?</span>
      <textarea id="ref-texto" class="textarea" rows="3" placeholder="Escribe tu reflexión del mes..."></textarea>
    </label>

    <div class="journal-actions">
      <button id="btn-cerrar" class="btn-cerrar">Cerrar Mes</button>
    </div>

    <div id="close-success" class="close-success">
      <p>Mes cerrado correctamente. <a href="/plan">Crear nuevo plan</a> para el próximo mes.</p>
    </div>
  </div>
</section>

<style>
  .journal-content {
    display: none;
    flex-direction: column;
    gap: 1.5rem;
  }

  .journal-loader {
    display: none;
  }
  .journal-loader.visible {
    display: block;
  }

  .empty-container {
    display: none;
  }
  .empty-container.visible {
    display: block;
  }

  .close-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .cs-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .cs-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .cs-value {
    font-size: 1.3rem;
    font-weight: 800;
  }

  .cs-income .cs-value { color: var(--amber); }
  .cs-expense .cs-value { color: var(--accent); }
  .cs-balance .cs-value { color: #4ade80; }
  .cs-balance.negative .cs-value { color: var(--accent); }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .label {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .textarea {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem;
    color: var(--text-primary);
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.9rem;
    resize: vertical;
    transition: border-color 0.15s ease;
  }

  .textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .textarea::placeholder {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .journal-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .btn-cerrar {
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 0.75rem 1.5rem;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 0.2s ease, opacity 0.2s ease, transform 0.15s ease;
  }

  .btn-cerrar:hover:not(:disabled) {
    background: var(--accent-bright);
    transform: translateY(-1px);
  }

  .btn-cerrar:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .close-success {
    display: none;
    text-align: center;
    padding: 1.5rem;
    background: rgba(74, 222, 128, 0.06);
    border: 1px solid rgba(74, 222, 128, 0.3);
    border-radius: 8px;
    color: var(--text-primary);
    font-weight: 600;
  }

  .close-success a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .close-summary { grid-template-columns: 1fr; }
    .cs-value { font-size: 1.1rem; }
  }

  @media (max-width: 480px) {
    .btn-cerrar { width: 100%; text-align: center; }
  }
</style>

<script>
  import { closeMonth } from "../lib/db.js";

  document.addEventListener("astro:page-load", function() {
    const planStr = localStorage.getItem("kakeibo-plan");
    const gastosStr = localStorage.getItem("kakeibo-gastos");
    const hasPlan = !!planStr;
    const gastos = gastosStr ? JSON.parse(gastosStr) : [];

    const journalEmpty = document.getElementById("journal-empty");
    const journalLoader = document.getElementById("journal-loader");
    const journalContent = document.getElementById("journal-content");
    const btnCerrar = document.getElementById("btn-cerrar");
    const closeSuccess = document.getElementById("close-success");
    const csIngreso = document.getElementById("cs-ingreso");
    const csGastos = document.getElementById("cs-gastos");
    const csBalance = document.getElementById("cs-balance");

    if (!hasPlan) {
      if (journalEmpty) journalEmpty.classList.add("visible");
      if (journalContent) journalContent.style.display = "none";
      if (journalLoader) journalLoader.classList.remove("visible");
      return;
    }

    if (journalEmpty) journalEmpty.classList.remove("visible");
    if (journalLoader) journalLoader.classList.add("visible");
    if (journalContent) journalContent.style.display = "none";

    // Simulate loading delay so spinners are visible
    setTimeout(function() {
      if (!document.body.contains(journalContent)) return;

      if (journalLoader) journalLoader.classList.remove("visible");
      if (journalContent) journalContent.style.display = "flex";

      // Show summary
      const plan = JSON.parse(planStr);
    const totalGastos = gastos.reduce(function(s, g) { return s + g.monto; }, 0);
    const ingreso = plan.ingreso || 0;
    const balance = ingreso - totalGastos;

    function formatCurrency(n) {
      const sym = localStorage.getItem("kakeibo-currency") || "$";
      return sym + n.toFixed(2);
    }

    if (csIngreso) csIngreso.textContent = formatCurrency(ingreso);
    if (csGastos) csGastos.textContent = formatCurrency(totalGastos);
    if (csBalance) {
      csBalance.textContent = (balance >= 0 ? "+" : "") + formatCurrency(balance);
      csBalance.parentElement.classList.toggle("negative", balance < 0);
    }

    // Restore saved reflection text if any
    const savedRef = localStorage.getItem("kakeibo-reflexion");
    if (savedRef) {
      try {
        const parsed = JSON.parse(savedRef);
        const textarea = document.getElementById("ref-texto");
        if (textarea && parsed.texto) textarea.value = parsed.texto;
      } catch(e) {}
    }

    function handleClose() {
      const textarea = document.getElementById("ref-texto");
      if (!textarea) return;
      const texto = textarea.value.trim();
      closeMonth(texto).then(function() {
        if (journalContent) journalContent.style.display = "none";
        if (closeSuccess) closeSuccess.style.display = "block";
        document.dispatchEvent(new CustomEvent("expense-add"));
        document.dispatchEvent(new CustomEvent("show-snackbar", {
          detail: { message: "Mes cerrado correctamente" }
        }));
      });
    }

    if (btnCerrar) {
      btnCerrar.removeEventListener("click", handleClose);
      btnCerrar.addEventListener("click", handleClose);
    }
    }, 2000);
  });
</script>
