<div id="snackbar" class="snackbar">
  <span id="snackbar-msg"></span>
</div>

<style>
  .snackbar {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: var(--surface);
    color: var(--text-primary);
    border: 1px solid var(--amber);
    border-radius: 10px;
    padding: 0.85rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    transform: translateY(calc(100% + 2rem));
    opacity: 0;
    transition: transform 0.35s ease, opacity 0.35s ease;
    z-index: 999;
  }

  .snackbar.visible {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<script>
  let timeout = null;

  function show(message) {
    const msg = document.getElementById("snackbar-msg");
    const el = document.getElementById("snackbar");
    if (!el || !msg) return;
    msg.textContent = message;
    if (timeout) clearTimeout(timeout);
    el.classList.add("visible");
    timeout = setTimeout(() => {
      el.classList.remove("visible");
    }, 3000);
  }

  function handleShow(e) {
    show(e.detail?.message || "");
  }

  function formatCurrency(n) {
    const sym = localStorage.getItem("kakeibo-currency") || "$";
    return sym + n.toFixed(2);
  }

  function handleExpense(e) {
    const { monto, categoria } = e.detail;
    show("Gasto registrado \u2014 " + formatCurrency(monto) + " en " + categoria);
  }

  document.addEventListener("astro:page-load", function() {
    document.removeEventListener("show-snackbar", handleShow);
    document.addEventListener("show-snackbar", handleShow);
    document.removeEventListener("expense-snackbar", handleExpense);
    document.addEventListener("expense-snackbar", handleExpense);
  });
</script>
