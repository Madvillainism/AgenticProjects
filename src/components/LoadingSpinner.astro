---

<style>
  .spinner-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem 1rem;
  }
  .spinner-wrap.small {
    padding: 0.5rem;
    gap: 0.5rem;
  }
  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  .spinner-wrap.small .spinner {
    width: 20px;
    height: 20px;
    border-width: 2px;
  }
  .spinner-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<div class="spinner-wrap {Astro.props.small ? 'small' : ''}">
  <div class="spinner"></div>
  {Astro.props.label && <span class="spinner-label">{Astro.props.label}</span>}
</div>
