---
const PILARES = ["Necesidades", "Deseos", "Cultura", "Imprevistos"];
const CAT_COLORS = {
  Necesidades: "#A855F7",
  Deseos: "#F59E0B",
  Cultura: "#E879F9",
  Imprevistos: "#FB923C",
};
---

<section class="compare-section">
  <h2 class="section-title">Comparativa Plan vs Real</h2>

  <table class="compare-table">
    <thead>
      <tr>
        <th>Pilar</th>
        <th>Plan</th>
        <th>Real</th>
        <th>Diferencia</th>
        <th>%</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="compare-tbody"></tbody>
  </table>

  <div id="compare-empty" class="empty-state">
    <p>Primero crea un <a href="/plan">plan mensual</a> y registra <a href="/gastos">gastos</a> para ver la comparativa.</p>
  </div>

  <div id="compare-summary" class="compare-summary">
    <div class="summary-donut">
      <div class="donut" id="donut-chart">
        <canvas id="rc-canvas"></canvas>
        <div class="donut-hole">
          <span class="donut-total-label">Real</span>
          <span class="donut-total-value" id="donut-total"></span>
        </div>
      </div>
      <div class="donut-legend" id="donut-legend"></div>
    </div>
    <div class="summary-stats">
      <div class="summary-card">
        <span class="summary-label">Total Plan</span>
        <span class="summary-value summary-plan" id="total-plan-val"></span>
      </div>
      <div class="summary-card">
        <span class="summary-label">Total Real</span>
        <span class="summary-value summary-real" id="total-real-val"></span>
      </div>
      <div class="summary-card">
        <span class="summary-label">Balance</span>
        <span class="summary-value summary-diff" id="total-diff-val"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .section-title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
  }

  .compare-table th {
    text-align: left;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
    padding: 0.6rem 0.5rem;
    border-bottom: 2px solid var(--border);
  }

  .compare-table td {
    padding: 0.6rem 0.5rem;
    font-size: 0.9rem;
    border-bottom: 1px solid var(--border);
    transition: background 0.2s ease;
  }

  .compare-table tbody tr:hover td {
    background: rgba(255, 255, 255, 0.03);
  }

  .tr-over td {
    background: rgba(168, 85, 247, 0.04);
  }

  .tr-over:hover td {
    background: rgba(168, 85, 247, 0.08);
  }

  .pilar-name {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .val-plan {
    color: var(--dorado);
    font-weight: 600;
  }

  .val-real {
    font-weight: 600;
  }

  .val-diff {
    font-weight: 700;
  }

  .diff-ok {
    color: #4ade80;
  }

  .diff-over {
    color: var(--rojo);
  }

  .pct-cell {
    font-weight: 600;
    font-size: 0.85rem;
  }

  .pct-ok {
    color: #4ade80;
  }

  .pct-over {
    color: var(--rojo);
  }

  .pct-icon {
    font-size: 0.75rem;
    margin-right: 2px;
  }

  .bar-cell {
    width: 100px;
  }

  .bar-container {
    width: 80px;
    height: 8px;
    background: var(--border);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  .bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.4s ease;
  }

  .bar-fill.ok {
    background: #4ade80;
  }

  .bar-fill.over {
    background: var(--rojo);
  }

  .bar-overflow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--rojo);
    margin-left: 4px;
    animation: pulse-overflow 1.5s ease-in-out infinite;
  }

  @keyframes pulse-overflow {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    border: 1px dashed var(--border);
    border-radius: 8px;
  }

  .empty-state a {
    color: var(--rojo);
    text-decoration: none;
    font-weight: 600;
  }

  .empty-state a:hover {
    text-decoration: underline;
  }

  .compare-summary {
    display: none;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    gap: 2rem;
    align-items: center;
  }

  .compare-summary.visible {
    display: flex;
  }

  .summary-donut {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .donut {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
  }

  #rc-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .donut-hole {
    position: absolute;
    inset: 24px;
    background: var(--bg);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .donut-total-label {
    font-size: 0.6rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .donut-total-value {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .donut-legend {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .summary-stats {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .summary-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 110px;
  }

  .summary-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .summary-value {
    font-size: 1.2rem;
    font-weight: 800;
  }

  .summary-plan {
    color: var(--dorado);
  }

  .summary-real {
    color: var(--text-primary);
  }

  .summary-diff {
    color: #4ade80;
  }

  .summary-diff.negative {
    color: var(--rojo);
  }

  @media (max-width: 768px) {
    .compare-table th, .compare-table td { padding: 0.4rem 0.3rem; font-size: 0.8rem; }
    .compare-summary { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .summary-stats { width: 100%; }
    .summary-card { min-width: 0; flex: 1; padding: 0.75rem; }
    .summary-card .summary-value { font-size: 1rem; }
    .bar-cell { display: none; }
    .compare-table th:last-child, .compare-table td:last-child { display: none; }
    .donut { width: 100px; height: 100px; }
    .donut-hole { inset: 20px; }
  }
</style>

<script>
  import { Chart, DoughnutController, ArcElement, Tooltip } from "chart.js";
  Chart.register(DoughnutController, ArcElement, Tooltip);
  Chart.defaults.color = "#C4B5FD";
  Chart.defaults.borderColor = "#3A1F4A";
  Chart.defaults.font.family = '"Plus Jakarta Sans", system-ui, sans-serif';

  let rcChart = null;

  document.addEventListener("astro:page-load", function() {
    const tbody = document.getElementById("compare-tbody");
    const empty = document.getElementById("compare-empty");
    const summary = document.getElementById("compare-summary");
    const canvas = document.getElementById("rc-canvas");
    const donutTotal = document.getElementById("donut-total");
    const donutLegend = document.getElementById("donut-legend");
    const totalPlanVal = document.getElementById("total-plan-val");
    const totalRealVal = document.getElementById("total-real-val");
    const totalDiffVal = document.getElementById("total-diff-val");
    const PILARES = ["Necesidades", "Deseos", "Cultura", "Imprevistos"];
    const CAT_COLORS = {
      Necesidades: "#A855F7",
      Deseos: "#F59E0B",
      Cultura: "#E879F9",
      Imprevistos: "#FB923C",
    };

    function formatCurrency(n) {
      const sym = localStorage.getItem("kakeibo-currency") || "$";
      return sym + n.toFixed(2);
    }

    function renderCompare() {
      const planStr = localStorage.getItem("kakeibo-plan");
      const gastosStr = localStorage.getItem("kakeibo-gastos");

      const plan = planStr ? JSON.parse(planStr) : null;
      const gastos = gastosStr ? JSON.parse(gastosStr) : [];

      if (!plan) {
        if (rcChart) { rcChart.destroy(); rcChart = null; }
        tbody.innerHTML = "";
        empty.style.display = "block";
        summary.classList.remove("visible");
        return;
      }

      const totales = {};
      PILARES.forEach(function(p) { totales[p] = 0; });
      gastos.forEach(function(g) {
        if (totales[g.categoria] !== undefined) {
          totales[g.categoria] += g.monto;
        }
      });

      empty.style.display = "none";

      let html = "";
      let planTotal = 0;
      let realTotal = 0;

      PILARES.forEach(function(p) {
        const planVal = plan.pilares ? (plan.pilares[p] || 0) : 0;
        const realVal = totales[p] || 0;
        const diff = realVal - planVal;
        const pct = planVal > 0 ? (realVal / planVal) * 100 : 0;
        const barPct = Math.min(pct, 100);
        const isOver = diff > 0;
        const pctDisplay = planVal > 0 ? pct.toFixed(1) + "%" : "\u2014";
        const overText = (isOver && pct > 100) ? "+" + (pct - 100).toFixed(1) + "%" : "";

        planTotal += planVal;
        realTotal += realVal;

        html += (
          '<tr class="' + (isOver ? "tr-over" : "") + '">' +
            '<td class="pilar-name">' + p + '</td>' +
            '<td class="val-plan" title="Plan: ' + formatCurrency(planVal) + '">' + formatCurrency(planVal) + '</td>' +
            '<td class="val-real" title="Real: ' + formatCurrency(realVal) + '">' + formatCurrency(realVal) + '</td>' +
            '<td class="val-diff ' + (isOver ? "diff-over" : "diff-ok") + '" title="Diferencia: ' + (diff >= 0 ? "+" : "") + formatCurrency(diff) + '">' +
              (diff >= 0 ? "+" : "") + formatCurrency(diff) +
            '</td>' +
            '<td class="pct-cell ' + (isOver ? "pct-over" : "pct-ok") + '">' +
              '<span class="pct-icon">' + (isOver ? "\u25B2" : "\u25BC") + '</span>' + pctDisplay +
            '</td>' +
            '<td class="bar-cell">' +
              '<div class="bar-container" title="' + pctDisplay + ' de presupuesto usado">' +
                '<div class="bar-fill ' + (isOver ? "over" : "ok") + '" style="width: ' + barPct + '%"></div>' +
              '</div>' +
              (overText ? '<span class="bar-overflow">' + overText + '</span>' : "") +
            '</td>' +
          '</tr>'
        );
      });

      const totalDiff = realTotal - planTotal;
      html += (
        '<tr class="' + (totalDiff > 0 ? "tr-over" : "") + '" style="border-top: 2px solid var(--border); font-weight: 800;">' +
          '<td class="pilar-name">Total</td>' +
          '<td class="val-plan">' + formatCurrency(planTotal) + '</td>' +
          '<td class="val-real">' + formatCurrency(realTotal) + '</td>' +
          '<td class="val-diff ' + (totalDiff > 0 ? "diff-over" : "diff-ok") + '">' +
            (totalDiff >= 0 ? "+" : "") + formatCurrency(totalDiff) +
          '</td>' +
          '<td></td>' +
          '<td></td>' +
        '</tr>'
      );

      tbody.innerHTML = html;

      // --- Donut chart ---
      const realVals = PILARES.map(function(p) { return totales[p] || 0; });
      const grandReal = realVals.reduce(function(a, b) { return a + b; }, 0);

      if (rcChart) rcChart.destroy();
      if (grandReal > 0) {
        rcChart = new Chart(canvas, {
          type: "doughnut",
          data: {
            labels: PILARES,
            datasets: [{
              data: realVals,
              backgroundColor: PILARES.map(function(p) { return CAT_COLORS[p]; }),
              borderColor: "#0B0710",
              borderWidth: 3,
              hoverOffset: 6,
            }],
          },
          options: {
            cutout: "60%",
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
              legend: { display: false },
              tooltip: {
                backgroundColor: "#1E1029",
                titleColor: "#F5F3FF",
                bodyColor: "#C4B5FD",
                borderColor: "#3A1F4A",
                borderWidth: 1,
                padding: 10,
                cornerRadius: 8,
                callbacks: {
                  label: function(ctx) {
                    var total = ctx.dataset.data.reduce(function(a, b) { return a + b; }, 0);
                    var pct = ((ctx.parsed / total) * 100).toFixed(1);
                    return ctx.label + ": " + formatCurrency(ctx.parsed) + " (" + pct + "%)";
                  },
                },
              },
            },
          },
        });

        donutTotal.textContent = formatCurrency(grandReal);

        donutLegend.innerHTML = PILARES.map(function(p, i) {
          return (
            '<div class="legend-item">' +
              '<span class="legend-dot" style="background: ' + CAT_COLORS[p] + '"></span>' +
              '<span>' + p + ': ' + formatCurrency(realVals[i]) + '</span>' +
            '</div>'
          );
        }).join("");
      } else {
        rcChart = null;
        donutTotal.textContent = "$0";
        donutLegend.innerHTML = '<div class="legend-item" style="color: var(--text-muted)">Sin gastos</div>';
      }

      // --- Summary cards ---
      totalPlanVal.textContent = formatCurrency(planTotal);
      totalRealVal.textContent = formatCurrency(realTotal);
      totalDiffVal.textContent = (totalDiff >= 0 ? "+" : "") + formatCurrency(totalDiff);
      totalDiffVal.className = "summary-value summary-diff" + (totalDiff > 0 ? " negative" : "");

      summary.classList.add("visible");
    }

    renderCompare();
    document.removeEventListener("expense-add", renderCompare);
    document.addEventListener("expense-add", renderCompare);
    document.removeEventListener("currency-change", renderCompare);
    document.addEventListener("currency-change", renderCompare);
  });
</script>
