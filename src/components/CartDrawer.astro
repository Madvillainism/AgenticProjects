  .drawer__total { display: flex; justify-content: space-between; font-size: 1rem; font-weight: 700; }
  .drawer__total span:last-child { color: var(--neon-yellow); }
  .drawer__checkout { width: 100%; padding: 1rem; font-size: 1rem; }
</style>