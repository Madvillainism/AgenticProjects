<aside class="cart-drawer" id="cartDrawer">
  <div class="drawer__header">
    <h2 class="drawer__title">Your <span>Cart</span></h2>
    <button class="drawer__close" id="cartClose" aria-label="Close cart">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="drawer__body" id="cartItems">
    <div class="drawer__empty">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      <p>Your cart is empty</p>
      <span style="font-size:0.75rem;color:var(--text-secondary)">Tap BUY $ to add items</span>
    </div>
  </div>
  <div class="drawer__footer" id="cartFooter" hidden>
    <div class="drawer__total"><span>Total</span><span id="cartTotal"></span></div>
    <button class="btn btn-glow drawer__checkout" id="cartCheckout">Checkout</button>
  </div>
</aside>
<div class="drawer-overlay" id="cartOverlay"></div>

<style>
  .drawer__header { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--concrete-light); }
  .drawer__title { font-family: var(--font-display); font-size: 1.3rem; letter-spacing: 0.05em; }
  .drawer__title span { color: var(--neon-cyan); }
  .drawer__close { color: var(--text-secondary); padding: 0.25rem; transition: color 0.2s; }
  .drawer__close:active { color: var(--neon-cyan); }
  .drawer__body { flex: 1; overflow-y: auto; padding: 1.5rem; }
  .drawer__empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; height: 100%; color: var(--text-secondary); font-size: 0.9rem; }
  .drawer__item { display: flex; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--concrete-light); }
  .drawer__item-img { width: 60px; height: 60px; border-radius: var(--radius-sm); object-fit: cover; flex-shrink: 0; border: 1px solid var(--concrete-light); }
  .drawer__item-info { flex: 1; display: flex; flex-direction: column; gap: 0.25rem; }
  .drawer__item-name { font-size: 0.9rem; font-weight: 600; font-family: var(--font-display); letter-spacing: 0.03em; }
  .drawer__item-price { font-size: 0.85rem; color: var(--neon-yellow); font-weight: 700; }
  .drawer__item-qty { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem; }
