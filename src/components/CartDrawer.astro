  .drawer__item-qty button:active { background: var(--neon-cyan); color: var(--charcoal); border-color: var(--neon-cyan); }
  .drawer__item-qty span { font-size: 0.9rem; min-width: 1.5rem; text-align: center; }
  .drawer__item-remove { color: var(--neon-magenta); font-size: 0.75rem; align-self: flex-start; padding: 0.25rem 0; }
