<section class="archived-section">
  <h2 class="section-title">Meses Archivados</h2>
  <div id="archived-empty" class="archived-empty">
    <p>
      Aún no hay meses archivados. Cierra un mes desde la <a href="/reflexion"
        >reflexión</a
      >.
    </p>
  </div>
  <div id="archived-list" class="archived-list"></div>
</section>

<style>
  .archived-empty {
    text-align: center;
    padding: 2rem 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    border: 1px dashed var(--border);
    border-radius: 8px;
  }

  .archived-empty a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }

  .archived-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .archived-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .archived-card:hover {
    border-color: var(--accent);
  }

  .archived-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    cursor: pointer;
    user-select: none;
    gap: 1rem;
  }

  .archived-month {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .archived-stats {
    display: flex;
    gap: 1.25rem;
    font-size: 0.8rem;
  }

  .archived-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.1rem;
  }

  .archived-stat-label {
    font-size: 0.65rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .archived-stat-value {
    font-weight: 700;
  }

  .archived-stat-value.positive {
    color: #4ade80;
  }
  .archived-stat-value.negative {
    color: var(--accent);
  }

  .archived-toggle {
    font-size: 0.8rem;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .archived-header.open .archived-toggle {
    transform: rotate(180deg);
  }

  .archived-body {
    max-height: 0;
    overflow: hidden;
    transition:
      max-height 0.35s ease,
      padding 0.35s ease;
    padding: 0 1.25rem;
    border-top: 1px solid var(--border);
  }

  .archived-body.open {
    max-height: 1200px;
    padding: 1.25rem;
    overflow-y: auto;
  }

  .archived-body-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  .archived-donut-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .archived-donut-col .donut {
    width: min(240px, 100%);
    aspect-ratio: 1;
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
  }

  [id^="ac-canvas-"] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .archived-donut-col .donut-hole {
    position: absolute;
    inset: 22%;
    background: var(--surface);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .archived-donut-col .donut-label {
    font-size: 0.55rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .archived-donut-col .donut-value {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .donut-legend {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 100%;
  }

  .donut-legend .legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .donut-legend .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ac-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }

  .ac-table th {
    text-align: left;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding: 0.5rem 0.4rem;
    border-bottom: 2px solid var(--border);
  }

  .ac-table td {
    padding: 0.4rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-primary);
  }

  .ac-table .pilar-name {
    font-weight: 600;
    color: var(--text-secondary);
  }

  .ac-table .td-right {
    text-align: right;
    font-weight: 700;
  }

  .ac-table .td-diff {
    font-weight: 700;
  }

  .ac-table .diff-ok {
    color: #4ade80;
  }
  .ac-table .diff-over {
    color: var(--accent);
  }

  .ac-total-row td {
    border-top: 2px solid var(--border);
    font-weight: 800;
    padding-top: 0.6rem;
  }

  .archived-reflexion {
    background: rgba(168, 85, 247, 0.06);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    margin-bottom: 1rem;
  }

  .archived-reflexion-title {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .archived-reflexion p {
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin: 0.25rem 0;
    line-height: 1.5;
  }

  .archived-reflexion strong {
    color: var(--text-primary);
  }

  .archived-reflexion .meta-ok {
    color: #4ade80;
    font-weight: 700;
  }
  .archived-reflexion .meta-fail {
    color: var(--accent);
    font-weight: 700;
  }

  .archived-dl-btn {
    width: 100%;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 0.7rem 1rem;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.15s ease,
      opacity 0.2s ease;
  }

  .archived-dl-btn:hover {
    background: var(--accent-bright);
    transform: translateY(-1px);
  }

  .archived-dl-btn:active {
    transform: translateY(0);
  }

  .archived-dl-btn.loading {
    opacity: 0.6;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .archived-header {
      flex-wrap: wrap;
    }
    .archived-stats {
      gap: 0.75rem;
    }
    .archived-stat {
      align-items: flex-start;
    }
    .archived-body-grid {
      grid-template-columns: 1fr;
    }
    .archived-month {
      font-size: 0.9rem;
    }
    .archived-donut-col .donut {
      width: min(140px, 100%);
    }
  }

  @media (max-width: 480px) {
    .archived-body.open {
      max-height: none;
    }
    .archived-header {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
    }
    .archived-stats {
      justify-content: space-around;
    }
  }
</style>

<script>
  import { Chart, DoughnutController, ArcElement, Tooltip } from "chart.js";
  Chart.register(DoughnutController, ArcElement, Tooltip);

  document.addEventListener("astro:page-load", function() {
    const empty = document.getElementById("archived-empty");
    const list = document.getElementById("archived-list");
    const MONTHS = ["Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"];
    const PILARES = ["Necesidades", "Deseos", "Cultura", "Imprevistos"];
    const CAT_COLORS = {
      Necesidades: "#A855F7",
      Deseos: "#F59E0B",
      Cultura: "#C084FC",
      Imprevistos: "#8B7AA8",
    };

    function formatCurrency(n) {
      const sym = localStorage.getItem("kakeibo-currency") || "$";
      return sym + n.toFixed(2);
    }

    function generateReportHTML(m) {
      const totalGastos = (m.gastos || []).reduce(function(s, g) { return s + g.monto; }, 0);
      const ingreso = m.plan ? m.plan.ingreso || 0 : 0;
      const balance = ingreso - totalGastos;
      const totales = {};
      PILARES.forEach(function(p) { totales[p] = 0; });
      (m.gastos || []).forEach(function(g) {
        if (totales[g.categoria] !== undefined) totales[g.categoria] += g.monto;
      });

      var pRows = PILARES.map(function(p) {
        var pv = (m.plan && m.plan.pilares ? m.plan.pilares[p] || 0 : 0);
        var rv = totales[p] || 0;
        var diff = rv - pv;
        var pct = pv > 0 ? (rv / pv * 100).toFixed(1) + "%" : "\u2014";
        return '<tr><td>' + p + '</td><td style="text-align:right">' + formatCurrency(pv) + '</td><td style="text-align:right">' + formatCurrency(rv) + '</td><td style="text-align:right;color:' + (diff > 0 ? "#e53e3e" : "#38a169") + '">' + (diff >= 0 ? "+" : "") + formatCurrency(diff) + '</td><td style="text-align:right">' + pct + '</td></tr>';
      }).join("");

      var gRows = (m.gastos || []).slice().sort(function(a, b) { return (b.id || 0) - (a.id || 0); }).map(function(g) {
        return '<tr><td>' + g.fecha + '</td><td>' + g.categoria + '</td><td style="text-align:right">' + formatCurrency(g.monto) + '</td><td>' + (g.descripcion || "\u2014") + '</td></tr>';
      }).join("");

      return '<html><head><meta charset="utf-8"><style>' +
        'body{font-family:"Plus Jakarta Sans",system-ui,sans-serif;color:#1a1a2e;padding:2rem;max-width:800px;margin:0 auto}' +
        'h1{color:#A855F7;font-size:1.8rem;text-align:center;letter-spacing:0.1em}' +
        '.sub{text-align:center;color:#666;text-transform:uppercase;letter-spacing:0.08em;font-size:0.85rem}' +
        'h2{color:#A855F7;font-size:1rem;border-left:3px solid #A855F7;padding-left:0.5rem;margin:1.5rem 0 0.75rem}' +
        'table{width:100%;border-collapse:collapse;font-size:0.85rem}' +
        'th{text-align:left;font-size:0.7rem;text-transform:uppercase;color:#999;padding:0.4rem 0.5rem;border-bottom:1px solid #eee}' +
        'td{padding:0.4rem 0.5rem;border-bottom:1px solid #f0f0f0}' +
        '.footer{text-align:center;font-size:0.75rem;color:#ccc;margin-top:2rem;padding-top:1rem;border-top:1px solid #eee}' +
        '.balance{font-size:1.2rem;font-weight:800;text-align:center;padding:1rem;background:#f8f4ff;border-radius:8px;margin-top:1rem}' +
        '.reflexion p{font-size:0.85rem;margin:0.3rem 0}' +
      '</style></head><body>' +
        '<h1>Kakeibo</h1>' +
        '<p class="sub">Resumen Mensual &mdash; ' + MONTHS[m.mes - 1] + " " + m.anio + '</p>' +
        '<h2>Plan Mensual</h2>' +
        '<table><tr><td>Ingreso</td><td style="text-align:right;font-weight:600">' + formatCurrency(ingreso) + '</td></tr>' +
        '<tr><td>Gastos Fijos</td><td style="text-align:right;font-weight:600">' + formatCurrency(m.plan ? m.plan.gastos_fijos || 0 : 0) + '</td></tr>' +
        '<tr><td>Meta de Ahorro</td><td style="text-align:right;font-weight:600">' + formatCurrency(m.plan ? m.plan.meta_ahorro || 0 : 0) + '</td></tr>' +
        '<tr><td>Dinero Disponible</td><td style="text-align:right;font-weight:600">' + formatCurrency(m.plan ? m.plan.dinero_disponible || 0 : 0) + '</td></tr>' +
        '<tr><td>Dinero para Gastar</td><td style="text-align:right;font-weight:600">' + formatCurrency(m.plan ? m.plan.dinero_gastar || 0 : 0) + '</td></tr></table>' +
        '<h2>Distribución por Pilares</h2>' +
        '<table><thead><tr><th>Pilar</th><th>Plan</th><th>Real</th><th>Dif</th><th>%</th></tr></thead><tbody>' + pRows + '</tbody></table>' +
        '<h2>Gastos</h2>' +
        '<p style="font-size:0.8rem;color:#999">' + (m.gastos || []).length + ' gasto(s)</p>' +
        '<table><thead><tr><th>Fecha</th><th>Categoría</th><th>Monto</th><th>Descripción</th></tr></thead><tbody>' + gRows + '</tbody></table>' +
        (m.reflexion ? '<h2>Reflexión</h2><div class="reflexion">' +
          (m.reflexion.aprendizaje ? '<p><strong>Aprendizaje:</strong> ' + m.reflexion.aprendizaje + '</p>' : "") +
          (m.reflexion.mejora ? '<p><strong>Mejora:</strong> ' + m.reflexion.mejora + '</p>' : "") +
          '<p style="color:' + (m.reflexion.cumplio_meta ? "#38a169" : "#e53e3e") + '">' + (m.reflexion.cumplio_meta ? "\u2713" : "\u2717") + ' Meta de ahorro ' + (m.reflexion.cumplio_meta ? "cumplida" : "no cumplida") + '</p>' +
        '</div>' : '') +
        '<div class="balance">Balance Final: ' + formatCurrency(balance) + '</div>' +
        '<p class="footer">Generado por Kakeibo &mdash; ' + new Date().toLocaleDateString("es-MX", { year: "numeric", month: "long", day: "numeric" }) + '</p>' +
      '</body></html>';
    }

    var chartInstances = {};

    function render() {
      const archivados = JSON.parse(localStorage.getItem("kakeibo-archived-meses") || "[]");

      if (archivados.length === 0) {
        empty.style.display = "block";
        list.innerHTML = "";
        return;
      }

      empty.style.display = "none";

      list.innerHTML = archivados.slice().reverse().map(function(m) {
        const totalGastos = (m.gastos || []).reduce(function(s, g) { return s + g.monto; }, 0);
        const ingreso = m.plan ? m.plan.ingreso || 0 : 0;
        const balance = ingreso - totalGastos;
        const hasReflexion = m.reflexion && (m.reflexion.aprendizaje || m.reflexion.mejora);
        const hasPilares = m.plan && m.plan.pilares;
        const refId = "ac-" + m.id;

        // Build comparison table rows
        var tableRows = "";
        let planTotal = 0, realTotal = 0;
        if (hasPilares) {
          PILARES.forEach(function(p) {
            var pv = m.plan.pilares[p] || 0;
            var rv = 0;
            (m.gastos || []).forEach(function(g) {
              if (g.categoria === p) rv += g.monto;
            });
            planTotal += pv;
            realTotal += rv;
            var diff = rv - pv;
            tableRows += '<tr>' +
              '<td class="pilar-name">' + p + '</td>' +
              '<td class="td-right">' + formatCurrency(pv) + '</td>' +
              '<td class="td-right">' + formatCurrency(rv) + '</td>' +
              '<td class="td-right td-diff ' + (diff > 0 ? "diff-over" : "diff-ok") + '">' + (diff >= 0 ? "+" : "") + formatCurrency(diff) + '</td>' +
              '<td class="td-right">' + (pv > 0 ? (rv / pv * 100).toFixed(1) + "%" : "\u2014") + '</td>' +
            '</tr>';
          });
          var totalDiff = realTotal - planTotal;
          tableRows += '<tr class="ac-total-row">' +
            '<td class="pilar-name">Total</td>' +
            '<td class="td-right">' + formatCurrency(planTotal) + '</td>' +
            '<td class="td-right">' + formatCurrency(realTotal) + '</td>' +
            '<td class="td-right td-diff ' + (totalDiff > 0 ? "diff-over" : "diff-ok") + '">' + (totalDiff >= 0 ? "+" : "") + formatCurrency(totalDiff) + '</td>' +
            '<td></td>' +
          '</tr>';
        }

        // Reflexion HTML
        var reflexionHtml = "";
        if (hasReflexion) {
          reflexionHtml = '<div class="archived-reflexion">' +
            '<div class="archived-reflexion-title">Reflexión</div>' +
            (m.reflexion.aprendizaje ? '<p><strong>Aprendizaje:</strong> ' + m.reflexion.aprendizaje + '</p>' : "") +
            (m.reflexion.mejora ? '<p><strong>Mejora:</strong> ' + m.reflexion.mejora + '</p>' : "") +
            '<p class="' + (m.reflexion.cumplio_meta ? "meta-ok" : "meta-fail") + '">' +
              (m.reflexion.cumplio_meta ? "\u2713" : "\u2717") + ' Meta de ahorro ' + (m.reflexion.cumplio_meta ? "cumplida" : "no cumplida") +
            '</p>' +
          '</div>';
        }

        return (
          '<div class="archived-card" data-archived-id="' + m.id + '">' +
            '<div class="archived-header" onclick="' +
              "var b=document.getElementById('" + refId + "');b.classList.toggle('open');" +
              "this.classList.toggle('open');" +
              "if(b.classList.contains('open')&&!b.getAttribute('data-inited')){b.setAttribute('data-inited','1');document.dispatchEvent(new CustomEvent('arch-expand',{detail:{id:" + m.id + "}}))}" +
            '">' +
              '<span class="archived-month">' + MONTHS[m.mes - 1] + " " + m.anio + '</span>' +
              '<div style="display:flex;align-items:center;gap:0.75rem">' +
                '<div class="archived-stats">' +
                  '<div class="archived-stat">' +
                    '<span class="archived-stat-label">Ingreso</span>' +
                    '<span class="archived-stat-value">' + formatCurrency(ingreso) + '</span>' +
                  '</div>' +
                  '<div class="archived-stat">' +
                    '<span class="archived-stat-label">Gastos</span>' +
                    '<span class="archived-stat-value">' + formatCurrency(totalGastos) + '</span>' +
                  '</div>' +
                  '<div class="archived-stat">' +
                    '<span class="archived-stat-label">Balance</span>' +
                    '<span class="archived-stat-value ' + (balance >= 0 ? "positive" : "negative") + '">' +
                      (balance >= 0 ? "+" : "") + formatCurrency(balance) +
                    '</span>' +
                  '</div>' +
                '</div>' +
                '<span class="archived-toggle">&#9660;</span>' +
              '</div>' +
            '</div>' +
            '<div id="' + refId + '" class="archived-body">' +
              (hasPilares ? (
                '<div class="archived-body-grid">' +
                  '<div class="archived-donut-col">' +
                    '<div class="donut">' +
                      '<canvas id="ac-canvas-' + m.id + '"></canvas>' +
                      '<div class="donut-hole">' +
                        '<span class="donut-label">Gastos</span>' +
                        '<span class="donut-value" id="ac-total-' + m.id + '">' + formatCurrency(totalGastos) + '</span>' +
                      '</div>' +
                    '</div>' +
                    '<div class="donut-legend" id="ac-legend-' + m.id + '"></div>' +
                  '</div>' +
                  '<div>' +
                    '<table class="ac-table">' +
                      '<thead><tr>' +
                        '<th>Pilar</th><th>Plan</th><th>Real</th><th>Dif</th><th>%</th>' +
                      '</tr></thead>' +
                      '<tbody>' + tableRows + '</tbody>' +
                    '</table>' +
                  '</div>' +
                '</div>'
              ) : '<div class="archived-no-data" style="font-size:0.8rem;color:var(--text-muted);font-style:italic;margin-bottom:1rem">Sin desglose de pilares</div>') +
              reflexionHtml +
              '<button class="archived-dl-btn" data-archived=\'' + JSON.stringify(m).replace(/'/g, "&#39;") + '\'>Descargar PDF</button>' +
            '</div>' +
          '</div>'
        );
      }).join("");

      // Attach PDF button handlers
      list.querySelectorAll(".archived-dl-btn").forEach(function(btn) {
        btn.removeEventListener("click", handlePDFClick);
        btn.addEventListener("click", handlePDFClick);
      });
    }

    function handlePDFClick(e) {
      var btn = e.currentTarget;
      if (btn.classList.contains("loading")) return;
      btn.classList.add("loading");
      btn.textContent = "Generando PDF...";

      try {
        var data = JSON.parse(btn.getAttribute("data-archived"));
        var html = generateReportHTML(data);

        import("html2pdf.js").then(function(html2pdf) {
          var opt = {
            margin: [0.5, 0.5, 0.5, 0.5],
            filename: "kakeibo-" + MONTHS[data.mes - 1] + "-" + data.anio + ".pdf",
            image: { type: "jpeg", quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, letterRendering: true },
            jsPDF: { unit: "in", format: "letter", orientation: "portrait" },
          };
          html2pdf.default().set(opt).from(html).save().then(function() {
            btn.classList.remove("loading");
            btn.textContent = "Descargar PDF";
          }).catch(function(err) {
            console.error("PDF error:", err);
            btn.classList.remove("loading");
            btn.textContent = "Error al generar PDF";
          });
        }).catch(function(err) {
          console.error("html2pdf import error:", err);
          btn.classList.remove("loading");
          btn.textContent = "Error al cargar PDF";
        });
      } catch(err) {
        console.error("PDF data error:", err);
        btn.classList.remove("loading");
        btn.textContent = "Descargar PDF";
      }
    }

    function handleExpand(e) {
      var id = e.detail.id;
      var canvas = document.getElementById("ac-canvas-" + id);
      var totalEl = document.getElementById("ac-total-" + id);
      var legendEl = document.getElementById("ac-legend-" + id);
      if (!canvas || chartInstances[id]) return;

      var archivados = JSON.parse(localStorage.getItem("kakeibo-archived-meses") || "[]");
      var m = archivados.find(function(a) { return a.id === id; });
      if (!m) return;

      var totales = {};
      PILARES.forEach(function(p) { totales[p] = 0; });
      (m.gastos || []).forEach(function(g) {
        if (totales[g.categoria] !== undefined) totales[g.categoria] += g.monto;
      });
      var vals = PILARES.map(function(p) { return totales[p] || 0; });
      var grandReal = vals.reduce(function(a, b) { return a + b; }, 0);

      if (grandReal > 0 && totalEl) {
        totalEl.textContent = formatCurrency(grandReal);
      }

      if (grandReal > 0 && canvas) {
        chartInstances[id] = new Chart(canvas, {
          type: "doughnut",
          data: {
            labels: PILARES,
            datasets: [{
              data: vals,
              backgroundColor: PILARES.map(function(p) { return CAT_COLORS[p]; }),
              borderColor: "#0E0915",
              borderWidth: 3,
              hoverOffset: 6,
            }],
          },
          options: {
            cutout: "60%",
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
              legend: { display: false },
              tooltip: {
                backgroundColor: "#271535",
                titleColor: "#F5F3FF",
                bodyColor: "#C4B5FD",
                borderColor: "rgba(168, 85, 247, 0.3)",
                borderWidth: 1,
                padding: 12,
                cornerRadius: 10,
                caretSize: 0,
                callbacks: {
                  label: function(ctx) {
                    var pct = ((ctx.parsed / grandReal) * 100).toFixed(1);
                    return ctx.label + ": " + formatCurrency(ctx.parsed) + " (" + pct + "%)";
                  },
                },
              },
            },
          },
        });
      }

      if (legendEl) {
        legendEl.innerHTML = PILARES.map(function(p, i) {
          return '<div class="legend-item"><span class="legend-dot" style="background:' + CAT_COLORS[p] + '"></span><span>' + p + ': ' + formatCurrency(vals[i]) + '</span></div>';
        }).join("");
      }
    }

    render();
    document.addEventListener("arch-expand", handleExpand);

    document.removeEventListener("expense-add", render);
    document.addEventListener("expense-add", render);
    document.removeEventListener("currency-change", render);
    document.addEventListener("currency-change", render);
  });
</script>
