<div class="expense-table-wrapper">
  <div class="table-header">
    <h2 class="table-title">Gastos del Mes</h2>
    <div class="table-filters">
      <select id="filter-categoria" class="filter-select">
        <option value="Todas">Todas las categorías</option>
        <option value="Necesidades">Necesidades</option>
        <option value="Deseos">Deseos</option>
        <option value="Cultura">Cultura</option>
        <option value="Imprevistos">Imprevistos</option>
      </select>
    </div>
  </div>

  <table class="expense-table">
    <thead>
      <tr>
        <th>Fecha</th>
        <th>Categoría</th>
        <th>Monto</th>
        <th>Descripción</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="expense-tbody">
    </tbody>
  </table>

  <p class="empty-msg" id="empty-msg">No hay gastos registrados este mes.</p>

  <div id="totals-breakdown" class="totals-breakdown">
    <h3 class="totals-title">Resumen por Categoría</h3>
    <div id="totals-grid" class="totals-grid"></div>
    <div class="totals-grand">
      <span class="totals-grand-label">Total General</span>
      <span class="totals-grand-value" id="totals-grand-value">$0.00</span>
    </div>
  </div>
</div>

<style>
  .expense-table-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .table-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .table-title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .filter-select {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    color: var(--text-primary);
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .filter-select:focus {
    outline: none;
    border-color: var(--rojo);
  }

  .expense-table {
    width: 100%;
    border-collapse: collapse;
  }

  .expense-table th {
    text-align: left;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .expense-table td {
    padding: 0.65rem 0.5rem;
    font-size: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .expense-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .cat-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: var(--border);
    color: var(--text-secondary);
  }

  .monto-positivo {
    font-weight: 700;
    color: var(--rojo);
  }

  .expense-table td:last-child {
    text-align: center;
    vertical-align: middle;
  }

  .btn-delete {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid transparent;
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 1.3rem;
    padding: 0.4rem;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease, background 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }

  .btn-delete:hover {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
    transform: scale(1.15);
    border-color: rgba(239, 68, 68, 0.3);
  }

  .btn-delete:active {
    transform: scale(0.95);
  }

  .empty-msg {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    border: 1px dashed var(--border);
    border-radius: 8px;
  }

  .totals-breakdown {
    display: none;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .totals-breakdown.visible {
    display: flex;
  }

  .totals-title {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .totals-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .total-cat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .total-cat-name {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .total-cat-value {
    font-size: 1rem;
    font-weight: 800;
  }

  .total-cat-bar {
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    overflow: hidden;
    margin-top: 0.2rem;
  }

  .total-cat-fill {
    height: 100%;
    border-radius: 2px;
  }

  .totals-grand {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--rojo);
    border-radius: 8px;
  }

  .totals-grand-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.05em;
  }

  .totals-grand-value {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--rojo);
  }

  @media (max-width: 768px) {
    .expense-table-wrapper { overflow-x: auto; }
    .expense-table th, .expense-table td { white-space: nowrap; padding: 0.5rem 0.35rem; font-size: 0.8rem; }
    .totals-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  document.addEventListener("astro:page-load", function() {
    let expenses = [];
    const saved = localStorage.getItem("kakeibo-gastos");
    if (saved) {
      try { expenses = JSON.parse(saved); } catch(e) {}
    }
    const CAT_COLORS = {
      Necesidades: "#A855F7",
      Deseos: "#F59E0B",
      Cultura: "#C084FC",
      Imprevistos: "#8B7AA8",
    };

    function formatCurrency(n) {
      const sym = localStorage.getItem("kakeibo-currency") || "$";
      return sym + n.toFixed(2);
    }

    function render() {
      const filter = document.getElementById("filter-categoria");
      const tbody = document.getElementById("expense-tbody");
      const empty = document.getElementById("empty-msg");
      const totalsBreakdown = document.getElementById("totals-breakdown");
      const totalsGrid = document.getElementById("totals-grid");
      const totalsGrandValue = document.getElementById("totals-grand-value");
      if (!filter || !tbody || !empty || !totalsBreakdown || !totalsGrid || !totalsGrandValue) return;

      const filtered = filter.value === "Todas"
        ? expenses
        : expenses.filter(function(e) { return e.categoria === filter.value; });

      const totals = {};
      filtered.forEach(function(e) {
        totals[e.categoria] = (totals[e.categoria] || 0) + e.monto;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = "";
        empty.style.display = "block";
        totalsBreakdown.classList.remove("visible");
        return;
      }
      empty.style.display = "none";
      totalsBreakdown.classList.add("visible");

      const sorted = [...filtered].sort(function(a, b) { return b.id - a.id; });

      tbody.innerHTML = sorted.map(function(e) {
        return (
          '<tr>' +
            '<td>' + e.fecha + '</td>' +
            '<td><span class="cat-badge">' + e.categoria + '</span></td>' +
            '<td class="monto-positivo">' + formatCurrency(e.monto) + '</td>' +
            '<td>' + (e.descripcion || "\u2014") + '</td>' +
            '<td><button class="btn-delete" data-id="' + e.id + '">' +
              '<svg width="1em" height="1em" viewBox="0 0 24 24">' +
                '<path fill="currentColor" d="M9 3v1H4v2h1v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6h1V4h-5V3H9M7 6h10v13H7V6m2 2v9h2V8H9m4 0v9h2V8h-2Z"/>' +
              '</svg>' +
            '</button></td>' +
          '</tr>'
        );
      }.bind(this)).join("");

      tbody.querySelectorAll(".btn-delete").forEach(function(btn) {
        btn.addEventListener("click", function() {
          const id = parseInt(this.dataset.id);
          handleExpenseRemove(id);
        });
      });

      const cats = ["Necesidades", "Deseos", "Cultura", "Imprevistos"];
      const grandTotal = Object.values(totals).reduce(function(a, b) { return a + b; }, 0);

      let gridHtml = "";
      cats.forEach(function(cat) {
        const val = totals[cat] || 0;
        const pct = grandTotal > 0 ? (val / grandTotal) * 100 : 0;
        gridHtml += (
          '<div class="total-cat-card">' +
            '<span class="total-cat-name">' + cat + '</span>' +
            '<span class="total-cat-value" style="color:' + CAT_COLORS[cat] + '">' + formatCurrency(val) + '</span>' +
            '<div class="total-cat-bar"><div class="total-cat-fill" style="width:' + pct + '%;background:' + CAT_COLORS[cat] + '"></div></div>' +
          '</div>'
        );
      });

      totalsGrid.innerHTML = gridHtml;
      totalsGrandValue.textContent = formatCurrency(grandTotal);
    }

    function handleExpenseAdd(e) {
      expenses.push(e.detail);
      localStorage.setItem("kakeibo-gastos", JSON.stringify(expenses));
      render();
    }

    function handleExpenseRemove(id) {
      expenses = expenses.filter(function(e) { return e.id !== id; });
      localStorage.setItem("kakeibo-gastos", JSON.stringify(expenses));
      render();
    }

    document.removeEventListener("expense-add", handleExpenseAdd);
    document.addEventListener("expense-add", handleExpenseAdd);

    const filter = document.getElementById("filter-categoria");
    if (filter) {
      filter.removeEventListener("change", render);
      filter.addEventListener("change", render);
    }

    render();
  });
</script>
