---
import { Icon } from "astro-icon/components";
---

<nav class="navbar">
  <a href="/" class="logo">
    <Icon name="mdi:wallet" class="logo-icon" />
    Kakeibo
  </a>
  <div class="nav-links">
    <a href="/">Inicio</a>
    <a href="/plan">Plan Mensual</a>
    <a href="/gastos">Gastos</a>
    <a href="/reflexion">Reflexión</a>
  </div>
  <button id="currency-toggle" class="currency-toggle" aria-label="Cambiar moneda">$</button>
</nav>

<style>
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }
  .logo {
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.08em;
    color: var(--text-primary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .logo-icon {
    color: var(--rojo);
    font-size: 1.5rem;
  }
  .nav-links {
    display: flex;
    gap: 2rem;
  }
  .nav-links a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .nav-links a:hover {
    color: var(--text-primary);
  }

  .currency-toggle {
    background: var(--border);
    border: 1px solid var(--text-muted);
    border-radius: 6px;
    color: var(--text-primary);
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
    margin-left: 1rem;
    transition: background 0.15s ease;
  }

  .currency-toggle:hover {
    background: var(--text-muted);
  }

  @media (max-width: 768px) {
    .nav-links { gap: 0.75rem; }
    .nav-links a { font-size: 0.7rem; letter-spacing: 0.03em; }
    .logo { font-size: 1rem; }
    .logo-icon { font-size: 1.2rem; }
  }

  @media (max-width: 500px) {
    .nav-links a { font-size: 0.6rem; }
    .currency-toggle { padding: 0.2rem 0.4rem; font-size: 0.75rem; }
  }
</style>

<script>
  document.addEventListener("astro:page-load", function() {
    const toggle = document.getElementById("currency-toggle");
    if (!toggle) return;

    function applyCurrency(sym) {
      toggle.textContent = sym;
      document.documentElement.style.setProperty("--currency-sym", `"${sym}"`);
      document.querySelectorAll(".currency-symbol").forEach(function(el) {
        el.textContent = sym;
      });
      document.dispatchEvent(new Event("currency-change"));
    }

    const saved = localStorage.getItem("kakeibo-currency") || "$";
    applyCurrency(saved);

    function handleToggle() {
      const current = localStorage.getItem("kakeibo-currency") || "$";
      const next = current === "$" ? "€" : "$";
      localStorage.setItem("kakeibo-currency", next);
      applyCurrency(next);
    }

    toggle.removeEventListener("click", handleToggle);
    toggle.addEventListener("click", handleToggle);
  });
</script>
