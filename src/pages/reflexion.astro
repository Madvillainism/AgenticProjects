---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReflectionJournal from "../components/ReflectionJournal.astro";
---

<BaseLayout title="Reflexión — Kakeibo">
  <div class="reflexion-layout">
    <h1 class="page-title">Reflexión del Mes</h1>
    <ReflectionJournal />
  </div>
</BaseLayout>

<style>
  .reflexion-layout {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 600px;
  }

  .page-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .page-title { font-size: 1.25rem; }
  }
</style>
