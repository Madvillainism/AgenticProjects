---
import Navbar from "../components/Navbar.astro";
import Snackbar from "../components/Snackbar.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        <Navbar />
      </div>
    </header>

    <main transition:animate="slide">
      <slot />
    </main>

    <Snackbar />

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Kakeibo</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --rojo: #A855F7;
    --rojo-brillante: #C084FC;
    --dorado: #F59E0B;
    --bg: #0B0710;
    --surface: #1E1029;
    --text-primary: #F5F3FF;
    --text-secondary: #C4B5FD;
    --text-muted: #8B7AA8;
    --border: #3A1F4A;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  html, body {
    height: 100%;
  }

  body {
    font-family: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
    background: linear-gradient(135deg, #0B0710 0%, #14071E 50%, #1E1029 100%);
    color: var(--text-primary);
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .site-header {
    background: rgba(30, 16, 41, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-container {
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }


  @media (max-width: 480px) {
    main { padding: 1rem; }
    .header-container { padding: 0.75rem 1rem; }
  }

  .site-footer {
    text-align: center;
    padding: 2rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
  }
</style>

<script>
  import { migrateFromLocalStorage } from "../lib/db.js";
  document.addEventListener("astro:page-load", () => {
    migrateFromLocalStorage();
  });
</script>
