---
import Navbar from "../components/Navbar.astro";
import Snackbar from "../components/Snackbar.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Outfit:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="header-container">
        <Navbar />
      </div>
    </header>

    <main transition:animate="slide">
      <slot />
    </main>

    <Snackbar />

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Kakeibo</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --accent: #A855F7;
    --accent-bright: #C084FC;
    --amber: #F59E0B;
    --success: #4ade80;
    --danger: #ef4444;
    --font-heading: "Outfit", sans-serif;
    --font-body: "Plus Jakarta Sans", system-ui, sans-serif;
    --bg: #0E0915;
    --surface: #271535;
    --text-primary: #F5F3FF;
    --text-secondary: #C4B5FD;
    --text-muted: #8B7AA8;
    --border: #3A1F4A;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  html, body {
    height: 100%;
  }

  body {
    font-family: var(--font-body);
    background:
      repeating-linear-gradient(45deg, transparent, transparent 40px, rgba(168, 85, 247, 0.03) 40px, rgba(168, 85, 247, 0.03) 41px),
      repeating-linear-gradient(-45deg, transparent, transparent 40px, rgba(168, 85, 247, 0.03) 40px, rgba(168, 85, 247, 0.03) 41px),
      linear-gradient(135deg, #0E0915 0%, #1A0927 50%, #271535 100%);
    color: var(--text-primary);
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  h1, h2, h3, .page-title, .section-title, .card-amount {
    font-family: var(--font-heading);
  }

  .section-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--accent);
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    animation: fadeIn 0.4s ease both;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  :focus:not(:focus-visible) {
    outline: none;
  }

  ::selection {
    background: var(--accent);
    color: white;
  }

  .site-header {
    background: rgba(39, 21, 53, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-container {
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }


  @media (max-width: 480px) {
    main { padding: 1rem; }
    .header-container { padding: 0.75rem 1rem; }
  }

  .site-footer {
    text-align: center;
    padding: 2rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
  }
</style>

<script>
  // Clean up orphaned Dexie IndexedDB from migration
  try { indexedDB.deleteDatabase("KakeiboDB"); } catch(e) {}
</script>


